{
  "description": "Injects ForgeLoop conventions at session start, refreshes the cost heat map in the background, and shows live session cost above the prompt",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cost_heatmap_refresh.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_picker.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./session_cost.tsx"
  ]
}
