.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.env
.venv/
dist/
build/

# Debugger session artifacts capture locals/variable values and may contain
# secrets; never commit them. **/ also covers sessions launched from a
# reproducer cwd in a repo subdirectory.
**/.claude/debug-reports/


# ForgeLoop-internal run artifacts (never committed). .claude/plans/ itself is
# NOT ignored: plans are tracked.
**/.claude/clean-code/
**/.claude/run-proofs/
**/.claude/plans/followups/
**/.claude/plans/divergence-reports/
